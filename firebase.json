{
  "hosting": {
    "target": "gameshow",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "regex": ".*",
        "headers": [
          {"key":"X-Content-Type-Options","value":"nosniff"},
          {"key":"Referrer-Policy","value":"no-referrer"},
          {"key":"Permissions-Policy","value":"camera=(self), microphone=()"},
          {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self'; media-src 'self' blob:; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}
        ]
      },
      {
        "regex": ".*",
        "headers": [{"key":"Cache-Control","value":"no-cache"}]
      },
      {
        "regex": ".+\\.(onnx|task)$",
        "headers": [{"key":"Content-Type","value":"application/octet-stream"}]
      }
    ]
  }
}

